# BidEasy backend `.env`
# Copy this file to `.env` in the same folder as start-all.sh, then fill values.
# Never commit `.env`.

# Postgres (Supabase pooler JDBC URL)
SUPABASE_DB_URL=jdbc:postgresql://YOUR_HOST:5432/postgres?sslmode=require
SUPABASE_DB_USERNAME=
SUPABASE_DB_PASSWORD=

# Clerk JWT verification (issuer + JWKS, from Clerk Dashboard)
CLERK_ISSUER=https://YOUR_CLERK_APP.clerk.accounts.dev
CLERK_JWKS_URL=https://YOUR_CLERK_APP.clerk.accounts.dev/.well-known/jwks.json

# Shared secret for internal service-to-service calls
INTERNAL_SERVICE_TOKEN=dev-internal-token

# Frontend origin allowed by the API gateway
CORS_ORIGIN=http://localhost:3000

# Eureka (leave as-is for local)
EUREKA_URL=http://localhost:8761/eureka/

# Dodo Payments (needed for wallet top-up only; bidding works without it if the wallet already has balance)
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PAYMENTS_BASE_URL=https://test.dodopayments.com
DODO_PRODUCT_ID=
DODO_RETURN_URL=http://localhost:3000/wallet
DODO_WEBHOOK_URL=
